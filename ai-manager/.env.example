APP_NAME=AI Manager
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-secret-key
LOG_LEVEL=INFO
LOG_PATH=/data/logs/ai-manager.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
DATABASE_URL=sqlite+aiosqlite:////data/ai_manager.db
AI_SERVER_NAME=AI Server
AI_SERVER_IP=192.168.1.50
AI_SERVER_MAC=AA:BB:CC:DD:EE:FF
SSH_PORT=22
SSH_USER=aiadmin
SSH_PRIVATE_KEY=/run/secrets/ssh_private_key
SSH_KNOWN_HOSTS=/data/known_hosts
SSH_TIMEOUT=8
SSH_SUDO_PASSWORD=
OLLAMA_URL=http://192.168.1.50:11434
OPENWEBUI_URL=http://192.168.1.50:3000
PING_TIMEOUT=2
BOOT_TIMEOUT=600
IDLE_TIMEOUT=3600
KEEPALIVE_EXTENSION_SECONDS=3600
GPU_THRESHOLD=10.0
CPU_THRESHOLD=10.0
HEALTH_CHECK_INTERVAL_SECONDS=20
METRICS_INTERVAL_SECONDS=60
IDLE_CHECK_INTERVAL_SECONDS=60
DATA_RETENTION_DAYS=30
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/prometheus
ADMIN_USERNAME=admin
# bcrypt hash generated with: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('change-me'))"
ADMIN_PASSWORD_HASH=$2b$12$0AdkzfmWfFh8D6h0bI5cfesf6Q5h8obgD4DTNsEmMYhGG6B0A8by2
ENERGY_KW_ESTIMATE=0.35
DISCORD_WEBHOOK_URL=
HOME_ASSISTANT_WEBHOOK_URL=
NTFY_URL=
NTFY_TOPIC=
ENABLE_TIMELINE=true
ENABLE_DARK_MODE=true
